{
  "name": "edex-ui",
  "productName": "eDEX-UI",
  "version": "2.2.8",
  "description": "A science fiction desktop running everywhere. Awesome.",
  "main": "src/_boot.js",
  "scripts": {
    "start": "electron src --nointro",
    "build": "electron-builder build",
    "postinstall": "electron-rebuild -f -w node-pty",
    "prebuild-linux": "node file-icons-generator.js",
    "build-linux": "electron-builder build --linux",
    "build-windows": "electron-builder build --windows",
    "build-darwin": "electron-builder build --macos",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitSquared/edex-ui.git"
  },
  "author": "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev)",
  "license": "GPL-3.0",
  "build": {
    "appId": "com.edex.ui",
    "productName": "eDEX-UI",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "LICENSE",
      "README.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "augmented-ui": "^2.0.0",
    "color": "^5.0.3",
    "geolite2-redist": "^3.1.3",
    "howler": "^2.2.4",
    "maxmind": "^5.0.6",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.16",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.0.227",
    "pretty-bytes": "^7.1.0",
    "shell-env": "^4.0.3",
    "signale": "^1.4.0",
    "smoothie": "^1.36.1",
    "systeminformation": "^5.31.11",
    "username": "^7.0.0",
    "which": "^7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "cson-parser": "^4.0.9",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "terser": "^5.48.0"
  }
}
